# ========================================================
# Variables de Entorno - Docu IT para Coolify / Producción
# ========================================================

# 1. Configuración Básica de Django
# --------------------------------------------------------
# Clave secreta (generar una cadena larga y aleatoria)
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria-en-produccion

# Modo Debug (False en producción)
DEBUG=False

# Dominios permitidos separados por comas
ALLOWED_HOSTS=docu.tuempresa.com,localhost

# Orígenes de confianza CSRF para HTTPS / Traefik / Coolify (IMPORTANTE: incluir protocolo https://)
CSRF_TRUSTED_ORIGINS=https://docu.tuempresa.com


# 2. Base de Datos: PostgreSQL (Recomendado para Coolify)
# --------------------------------------------------------
# Podés conectar PostgreSQL usando variables individuales O una sola DATABASE_URL:

# Opción A: Variables individuales
DB_NAME=docu_db
DB_USER=docu_user
DB_PASSWORD=cambiar-password-seguro-postgres
DB_HOST=192.168.1.50
DB_PORT=5432

# Opción B: DATABASE_URL única (usada comúnmente al conectar recursos dentro de Coolify)
# DATABASE_URL=postgresql://docu_user:cambiar-password-seguro-postgres@192.168.1.50:5432/docu_db

# Opción C: SQLite (solo si no se configura PostgreSQL)
# SQLITE_DB_PATH=/app/data/db.sqlite3


# 3. Almacenamiento Persistente / Carpeta Compartida Windows (SMB/CIFS)
# --------------------------------------------------------
# Si usás un volumen CIFS nativo de Docker para montar una carpeta compartida de Windows:
# SMB_SERVER_IP=192.168.1.200
# SMB_SHARE_NAME=DocumentosCompartidos
# SMB_USER=usuario_windows
# SMB_PASS=password_windows
# SMB_DOMAIN=DOMINIO_EMPRESA


# 4. Superusuario Automático Inicial (Opcional)
# --------------------------------------------------------
# Si se definen, el contenedor creará el administrador al iniciar por primera vez
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambiar-password-admin-seguro
DJANGO_SUPERUSER_EMAIL=admin@tuempresa.com


# 5. Rendimiento de Gunicorn
# --------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
